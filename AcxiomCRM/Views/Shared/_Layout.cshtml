<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM Enterprise</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="crm-wrapper">
            <!-- Sidebar -->
            <aside class="crm-sidebar" id="sidebar">
                <div class="sidebar-brand d-flex align-items-center justify-content-between p-3 border-bottom border-dark-subtle">
                    <a asp-controller="Dashboard" asp-action="Index" class="d-flex align-items-center text-white text-decoration-none">
                        <div class="brand-logo-badge me-2">
                            <i class="bi bi-shield-shaded"></i>
                        </div>
                        <span class="fs-5 fw-bold brand-text">Acxiom<span class="text-accent">CRM</span></span>
                    </a>
                    <button class="btn btn-sm btn-link text-white-50 d-lg-none" id="sidebarClose">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <div class="sidebar-nav-container py-3">
                    <div class="nav-section-title px-3 mb-1 text-uppercase text-white-50 small fw-semibold">Overview</div>
                    <ul class="nav flex-column mb-3">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-grid-1x2-fill me-2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                    </ul>

                    <div class="nav-section-title px-3 mb-1 text-uppercase text-white-50 small fw-semibold">Sales Pipeline</div>
                    <ul class="nav flex-column mb-3">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                                <i class="bi bi-building me-2"></i>
                                <span>Customers</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leads" ? "active" : "")" asp-controller="Leads" asp-action="Index">
                                <i class="bi bi-funnel-fill me-2"></i>
                                <span>Leads</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Opportunities" ? "active" : "")" asp-controller="Opportunities" asp-action="Index">
                                <i class="bi bi-cash-stack me-2"></i>
                                <span>Opportunities</span>
                            </a>
                        </li>
                    </ul>

                    <div class="nav-section-title px-3 mb-1 text-uppercase text-white-50 small fw-semibold">Engagement</div>
                    <ul class="nav flex-column mb-3">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FollowUps" ? "active" : "")" asp-controller="FollowUps" asp-action="Index">
                                <i class="bi bi-calendar-event me-2"></i>
                                <span>Follow-Ups</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activities" ? "active" : "")" asp-controller="Activities" asp-action="Index">
                                <i class="bi bi-journal-text me-2"></i>
                                <span>Activity Log</span>
                            </a>
                        </li>
                    </ul>

                    <div class="nav-section-title px-3 mb-1 text-uppercase text-white-50 small fw-semibold">Analytics & Reports</div>
                    <ul class="nav flex-column mb-3">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-pie-chart-fill me-2"></i>
                                <span>Reports Center</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Customers" ? "active" : "")" asp-controller="Reports" asp-action="Customers">
                                <i class="bi bi-file-earmark-spreadsheet me-2"></i>
                                <span>Customer Report</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Leads" ? "active" : "")" asp-controller="Reports" asp-action="Leads">
                                <i class="bi bi-file-earmark-bar-graph me-2"></i>
                                <span>Lead Report</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Opportunities" ? "active" : "")" asp-controller="Reports" asp-action="Opportunities">
                                <i class="bi bi-cash me-2"></i>
                                <span>Opportunity Report</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "FollowUps" ? "active" : "")" asp-controller="Reports" asp-action="FollowUps">
                                <i class="bi bi-clock-history me-2"></i>
                                <span>Follow-Up Report</span>
                            </a>
                        </li>
                    </ul>

                    @if (User.IsInRole(AppRoles.Admin))
                    {
                        <div class="nav-section-title px-3 mb-1 text-uppercase text-white-50 small fw-semibold">System Administration</div>
                        <ul class="nav flex-column mb-4">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                                    <i class="bi bi-people-fill me-2"></i>
                                    <span>User Management</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "AuditLogs" ? "active" : "")" asp-controller="Reports" asp-action="AuditLogs">
                                    <i class="bi bi-shield-lock-fill me-2"></i>
                                    <span>Security Audit Logs</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/swagger" target="_blank">
                                    <i class="bi bi-code-slash me-2"></i>
                                    <span>Swagger API Explorer</span>
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </aside>

            <!-- Main Page Content -->
            <div class="crm-main-content">
                <!-- Top Navbar -->
                <header class="crm-topbar bg-white border-bottom shadow-sm px-4 py-2 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-outline-secondary btn-sm me-3 d-lg-none" id="sidebarToggle">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <h5 class="mb-0 fw-bold text-dark d-none d-sm-block">@ViewData["Title"]</h5>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-light text-dark border d-none d-md-inline-flex align-items-center">
                            <i class="bi bi-clock me-1 text-primary"></i>
                            <span id="currentTime">@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC</span>
                        </span>
                        <partial name="_LoginPartial" />
                    </div>
                </header>

                <!-- Page Body -->
                <main class="container-fluid p-4">
                    <partial name="_Alerts" />
                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="crm-footer bg-white border-top py-3 px-4 text-muted small d-flex justify-content-between align-items-center">
                    <div>
                        &copy; @DateTime.UtcNow.Year AcxiomCRM Enterprise System. All rights reserved.
                    </div>
                    <div>
                        <span class="badge bg-secondary-subtle text-secondary">v1.0.0 Production Ready</span>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Anonymous / Auth layout (Login/Register) -->
        <main class="auth-wrapper min-vh-100 d-flex align-items-center justify-content-center p-3">
            <div class="w-100" style="max-width: 480px;">
                <partial name="_Alerts" />
                @RenderBody()
            </div>
        </main>
    }

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
