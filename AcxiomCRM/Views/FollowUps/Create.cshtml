@model AcxiomCRM.ViewModels.FollowUpVM
@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
                    <h5 class="card-title mb-0 fw-bold">Schedule Enterprise Follow-Up</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Subject" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Subject" class="form-control" placeholder="Product Demo & Requirement Review" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="FollowUpType" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="FollowUpType" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.FollowUpType>()"></select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FollowUpDate" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="FollowUpDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.FollowUpStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="Model.Customers">
                                <option value="">-- Customer (Optional) --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="LeadId" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="Model.Leads">
                                <option value="">-- Lead (Optional) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="OpportunityId" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="OpportunityId" class="form-select" asp-items="Model.Opportunities">
                                <option value="">-- Opportunity (Optional) --</option>
                            </select>
                            <span asp-validation-for="OpportunityId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignedTo" class="form-label fw-semibold small text-muted"></label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="Model.SalesExecutives">
                            <option value="">-- Assign Sales Executive --</option>
                        </select>
                        <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Remarks" class="form-label fw-semibold small text-muted"></label>
                        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Agenda items, video conference link, notes..."></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-calendar-check me-1"></i> Schedule Follow-Up</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
