@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = $"Follow-Up - {Model.Subject}";
    bool isOverdue = Model.Status == FollowUpStatus.Planned && Model.FollowUpDate.Date < DateTime.UtcNow.Date;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h2 class="fw-bold mb-0">@Model.Subject</h2>
            <span class="badge bg-light text-dark border me-2">@Model.FollowUpType</span>
            <span class="badge @(Model.Status == FollowUpStatus.Completed ? "bg-success-subtle text-success" : Model.Status == FollowUpStatus.Planned ? "bg-warning-subtle text-warning" : "bg-secondary-subtle text-secondary")">
                @Model.Status
            </span>
            @if (isOverdue)
            {
                <span class="badge bg-danger ms-2">OVERDUE</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.FollowUpId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Task
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card mb-4">
            <div class="card-header bg-white">
                <span class="fw-bold">Follow-Up Specification</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Scheduled Date & Time</label>
                    <span class="fs-5 fw-bold @(isOverdue ? "text-danger" : "text-dark")">@Model.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</span>
                </div>

                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Related Customer</label>
                    @if (Model.Customer != null)
                    {
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-bold text-decoration-none">
                            <i class="bi bi-building me-1"></i> @Model.Customer.CustomerName
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">None</span>
                    }
                </div>

                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Related Lead</label>
                    @if (Model.Lead != null)
                    {
                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId" class="fw-bold text-decoration-none">
                            <i class="bi bi-funnel me-1"></i> @Model.Lead.LeadName
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">None</span>
                    }
                </div>

                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Related Opportunity</label>
                    @if (Model.Opportunity != null)
                    {
                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@Model.OpportunityId" class="fw-bold text-decoration-none">
                            <i class="bi bi-cash me-1"></i> @Model.Opportunity.OpportunityName
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">None</span>
                    }
                </div>

                <div>
                    <label class="text-muted small text-uppercase fw-semibold d-block">Assigned Representative</label>
                    <span class="badge bg-primary-subtle text-primary">@(Model.AssignedToUser != null ? Model.AssignedToUser.FullName : "Unassigned")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        @if (!string.IsNullOrEmpty(Model.Remarks))
        {
            <div class="card mb-4">
                <div class="card-header bg-white">
                    <span class="fw-bold">Agenda & Remarks</span>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-0 small" style="white-space: pre-wrap;">@Model.Remarks</p>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header bg-white">
                <span class="fw-bold">Audit Meta</span>
            </div>
            <div class="card-body small text-muted">
                <div>Created: @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
            </div>
        </div>
    </div>
</div>
