@model List<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Schedule";
    var filter = (AcxiomCRM.ViewModels.FollowUpFilterVM)ViewBag.Filter;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int overdueCount = ViewBag.OverdueCount ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Follow-Up Tasks</h2>
        <p class="text-muted mb-0 small">Schedule and manage calls, meetings, emails, and follow-ups with SLA tracking</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
            <i class="bi bi-calendar-plus me-2"></i> Schedule Follow-Up
        </a>
    </div>
</div>

@if (overdueCount > 0)
{
    <div class="alert alert-danger d-flex align-items-center mb-4">
        <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
        <div>
            <strong>Attention Required:</strong> You have <strong>@overdueCount</strong> overdue follow-up task(s) past their planned completion deadline.
        </div>
    </div>
}

<!-- Search & Filter Card -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <select name="Status" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.FollowUpStatus>()">
                    <option value="">All Follow-up Statuses</option>
                </select>
            </div>
            <div class="col-md-4">
                <input type="date" name="Date" class="form-control" placeholder="Target date" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Ups Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Follow-Up Schedule (@totalCount)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Type / Subject</th>
                        <th>Related Entity</th>
                        <th>Assignee</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var f in Model)
                        {
                            bool isOverdue = f.Status == FollowUpStatus.Planned && f.FollowUpDate.Date < DateTime.UtcNow.Date;
                            <tr class="@(isOverdue ? "table-danger" : "")">
                                <td>
                                    <div class="fw-bold @(isOverdue ? "text-danger" : "")">
                                        @f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")
                                    </div>
                                    @if (isOverdue)
                                    {
                                        <span class="badge bg-danger small">OVERDUE</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@f.Subject</div>
                                    <span class="badge bg-light text-dark border small">@f.FollowUpType</span>
                                </td>
                                <td>
                                    @if (f.Customer != null)
                                    {
                                        <div><i class="bi bi-building me-1 text-primary"></i>@f.Customer.CustomerName</div>
                                    }
                                    else if (f.Lead != null)
                                    {
                                        <div><i class="bi bi-funnel me-1 text-info"></i>@f.Lead.LeadName</div>
                                    }
                                    else if (f.Opportunity != null)
                                    {
                                        <div><i class="bi bi-cash me-1 text-success"></i>@f.Opportunity.OpportunityName</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        @(f.AssignedToUser != null ? f.AssignedToUser.FullName : "Unassigned")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(f.Status == FollowUpStatus.Completed ? "bg-success-subtle text-success" : f.Status == FollowUpStatus.Planned ? "bg-warning-subtle text-warning" : "bg-secondary-subtle text-secondary")">
                                        @f.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-action-group">
                                        <a asp-action="Details" asp-route-id="@f.FollowUpId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (f.Status == FollowUpStatus.Planned)
                                        {
                                            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#completeModal-@f.FollowUpId" title="Complete">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <form asp-action="Cancel" asp-route-id="@f.FollowUpId" method="post" class="d-inline" onsubmit="return confirm('Cancel this follow-up?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-secondary" title="Cancel">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>

                                    @if (f.Status == FollowUpStatus.Planned)
                                    {
                                        <!-- Modal for completing follow up -->
                                        <div class="modal fade text-start" id="completeModal-@f.FollowUpId" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-header">
                                                            <h6 class="modal-title fw-bold">Complete Follow-Up: @f.Subject</h6>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold">Outcome / Completion Notes:</label>
                                                                <textarea name="notes" class="form-control" rows="3" required placeholder="Meeting concluded with client agreement on proposal..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                                                            <button type="submit" class="btn btn-success btn-sm">Mark as Completed</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-check fs-1 d-block mb-2 text-muted"></i>
                                No scheduled follow-ups found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @filter.Page of @totalPages</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(filter.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(filter.Page - 1)" asp-route-Status="@filter.Status">&laquo;</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(filter.Page == p ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-Page="@p" asp-route-Status="@filter.Status">@p</a>
                        </li>
                    }
                    <li class="page-item @(filter.Page >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(filter.Page + 1)" asp-route-Status="@filter.Status">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
