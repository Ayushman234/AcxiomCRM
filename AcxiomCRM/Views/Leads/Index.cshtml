@model List<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Leads Management";
    var filter = (AcxiomCRM.ViewModels.LeadFilterVM)ViewBag.Filter;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Lead Pipeline</h2>
        <p class="text-muted mb-0 small">Capture prospects, qualify leads, and track status transitions</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
            <i class="bi bi-funnel-fill me-2"></i> Add Lead
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="Search" value="@filter.Search" class="form-control border-start-0" placeholder="Search lead name, email, company..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="Status" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.LeadStatus>()">
                    <option value="">All Lead Statuses</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Leads List Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">All Leads (@totalCount)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Lead</th>
                        <th>Source / Company</th>
                        <th>Priority</th>
                        <th>Est. Value</th>
                        <th>Assigned To</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var lead in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@lead.LeadName</div>
                                    <div class="text-muted small"><i class="bi bi-envelope me-1"></i>@lead.Email</div>
                                </td>
                                <td>
                                    <div>@(string.IsNullOrEmpty(lead.CompanyName) ? "Individual" : lead.CompanyName)</div>
                                    <span class="badge bg-light text-secondary border small">@lead.Source</span>
                                </td>
                                <td>
                                    <span class="badge @(lead.Priority == LeadPriority.High ? "bg-danger-subtle text-danger" : lead.Priority == LeadPriority.Medium ? "bg-warning-subtle text-warning" : "bg-info-subtle text-info")">
                                        @lead.Priority
                                    </span>
                                </td>
                                <td class="fw-semibold">
                                    @lead.ExpectedValue.ToString("C0")
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        @(lead.AssignedToUser != null ? lead.AssignedToUser.FullName : "Unassigned")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(lead.Status == LeadStatus.Converted ? "badge-status-converted" : lead.Status == LeadStatus.Qualified ? "badge-status-qualified" : lead.Status == LeadStatus.Contacted ? "badge-status-contacted" : lead.Status == LeadStatus.Lost ? "badge-status-lost" : "badge-status-new")">
                                        @lead.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-action-group">
                                        <a asp-action="Details" asp-route-id="@lead.LeadId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@lead.LeadId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (lead.Status == LeadStatus.Qualified)
                                        {
                                            <form asp-action="Convert" asp-route-id="@lead.LeadId" method="post" class="d-inline" onsubmit="return confirm('Convert this lead into an active Customer?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success" title="Convert to Customer">
                                                    <i class="bi bi-check-circle"></i> Convert
                                                </button>
                                            </form>
                                        }
                                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                                        {
                                            <form asp-action="Delete" asp-route-id="@lead.LeadId" method="post" class="d-inline" onsubmit="return confirm('Deactivate lead @lead.LeadName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Deactivate">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-funnel fs-1 d-block mb-2 text-muted"></i>
                                No leads match your filter.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @filter.Page of @totalPages</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(filter.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(filter.Page - 1)" asp-route-Search="@filter.Search" asp-route-Status="@filter.Status">&laquo;</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(filter.Page == p ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-Page="@p" asp-route-Search="@filter.Search" asp-route-Status="@filter.Status">@p</a>
                        </li>
                    }
                    <li class="page-item @(filter.Page >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(filter.Page + 1)" asp-route-Search="@filter.Search" asp-route-Status="@filter.Status">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
