@model AcxiomCRM.ViewModels.LeadVM
@{
    ViewData["Title"] = "Edit Lead";
    var currentStatus = (AcxiomCRM.Models.LeadStatus)ViewBag.CurrentStatus;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
                    <h5 class="card-title mb-0 fw-bold">Edit Lead: @Model.LeadName</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info d-flex align-items-center mb-4">
                    <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                    <div>
                        Current Stage: <strong>@currentStatus</strong>.
                        @if (currentStatus == LeadStatus.New)
                        {
                            <span>Valid next transitions: <strong>Contacted</strong> or <strong>Lost</strong>.</span>
                        }
                        else if (currentStatus == LeadStatus.Contacted)
                        {
                            <span>Valid next transitions: <strong>Qualified</strong> or <strong>Lost</strong>.</span>
                        }
                        else if (currentStatus == LeadStatus.Qualified)
                        {
                            <span>Valid next transitions: <strong>Converted</strong> or <strong>Lost</strong>.</span>
                        }
                        else
                        {
                            <span>This lead is in terminal status (@currentStatus).</span>
                        }
                    </div>
                </div>

                <form asp-action="Edit" asp-route-id="@Model.LeadId" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="LeadName" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="LeadName" class="form-control" />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CompanyName" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.LeadStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Source" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="Source" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.LeadSource>()"></select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Priority" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.LeadPriority>()"></select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="ExpectedValue" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignedTo" class="form-label fw-semibold small text-muted"></label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="Model.SalesExecutives">
                            <option value="">-- Assign Sales Executive --</option>
                        </select>
                        <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold small text-muted"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Update Lead</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
