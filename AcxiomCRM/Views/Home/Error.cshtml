@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="stat-icon-wrapper stat-icon-danger mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h3 class="fw-bold text-dark">An Unexpected Error Occurred</h3>
        <p class="text-muted mb-4">
            An error occurred while processing your request. Please try again or return to the dashboard.
        </p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>
