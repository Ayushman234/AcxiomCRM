@model List<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunities & Pipeline";
    var filter = (AcxiomCRM.ViewModels.OpportunityFilterVM)ViewBag.Filter;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Deal Pipeline</h2>
        <p class="text-muted mb-0 small">Track deal stages, revenue forecasts, and win probabilities</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
            <i class="bi bi-cash-stack me-2"></i> New Opportunity
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="Search" value="@filter.Search" class="form-control border-start-0" placeholder="Search opportunity name..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="Stage" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.OpportunityStage>()">
                    <option value="">All Pipeline Stages</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunities List Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Active Opportunities (@totalCount)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Deal Name</th>
                        <th>Account / Prospect</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th>Close Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var opp in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@opp.OpportunityName</div>
                                    <span class="badge bg-light text-dark border small">@(opp.AssignedToUser != null ? opp.AssignedToUser.FullName : "Unassigned")</span>
                                </td>
                                <td>
                                    @if (opp.Customer != null)
                                    {
                                        <div class="fw-medium text-dark"><i class="bi bi-building me-1 text-primary"></i>@opp.Customer.CustomerName</div>
                                    }
                                    else if (opp.Lead != null)
                                    {
                                        <div class="fw-medium text-muted"><i class="bi bi-funnel me-1 text-info"></i>@opp.Lead.LeadName</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold fs-6 text-dark">@opp.Amount.ToString("C0")</span>
                                </td>
                                <td>
                                    <span class="badge @(opp.Stage == OpportunityStage.Won ? "badge-stage-closedwon" : opp.Stage == OpportunityStage.Lost ? "badge-stage-closedlost" : opp.Stage == OpportunityStage.Negotiation ? "badge-stage-negotiation" : opp.Stage == OpportunityStage.Proposal ? "badge-stage-proposal" : "badge-stage-qualification")">
                                        @opp.Stage
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                            <div class="progress-bar @(opp.Probability >= 70 ? "bg-success" : opp.Probability >= 40 ? "bg-warning" : "bg-danger")" style="width: @opp.Probability%"></div>
                                        </div>
                                        <span class="small fw-semibold">@opp.Probability%</span>
                                    </div>
                                </td>
                                <td class="text-muted small">
                                    @opp.ExpectedCloseDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-action-group">
                                        <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@opp.OpportunityId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                                        {
                                            <form asp-action="Delete" asp-route-id="@opp.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Delete opportunity @opp.OpportunityName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-cash-stack fs-1 d-block mb-2 text-muted"></i>
                                No opportunities found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @filter.Page of @totalPages</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(filter.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(filter.Page - 1)" asp-route-Search="@filter.Search" asp-route-Stage="@filter.Stage">&laquo;</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(filter.Page == p ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-Page="@p" asp-route-Search="@filter.Search" asp-route-Stage="@filter.Stage">@p</a>
                        </li>
                    }
                    <li class="page-item @(filter.Page >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(filter.Page + 1)" asp-route-Search="@filter.Search" asp-route-Stage="@filter.Stage">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
