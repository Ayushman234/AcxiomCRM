@model AcxiomCRM.ViewModels.OpportunityVM
@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
                    <h5 class="card-title mb-0 fw-bold">Edit Opportunity: @Model.OpportunityName</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="OpportunityName" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="OpportunityName" class="form-control" />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="Model.Customers">
                                <option value="">-- Select Existing Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LeadId" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="Model.Leads">
                                <option value="">-- Or Select Lead Prospect --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Amount" class="form-label fw-semibold small text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Probability" class="form-label fw-semibold small text-muted"></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Stage" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="Stage" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.OpportunityStage>()"></select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.OpportunityStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Source" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="Source" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.LeadSource>()"></select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignedTo" class="form-label fw-semibold small text-muted"></label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="Model.SalesExecutives">
                            <option value="">-- Assign Sales Executive --</option>
                        </select>
                        <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold small text-muted"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Update Opportunity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
