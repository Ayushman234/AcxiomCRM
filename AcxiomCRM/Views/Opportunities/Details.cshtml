@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = $"Opportunity - {Model.OpportunityName}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h2 class="fw-bold mb-0">@Model.OpportunityName</h2>
            <span class="badge @(Model.Stage == OpportunityStage.Won ? "badge-stage-closedwon" : Model.Stage == OpportunityStage.Lost ? "badge-stage-closedlost" : "bg-primary-subtle text-primary") me-2">
                @Model.Stage
            </span>
            <span class="badge @(Model.Status == OpportunityStatus.Open ? "bg-info-subtle text-info" : "bg-secondary-subtle text-secondary")">
                @Model.Status
            </span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Deal
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card mb-4">
            <div class="card-header bg-white">
                <span class="fw-bold">Financials & Timeline</span>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Deal Value</label>
                        <span class="fs-4 fw-bold text-success">@Model.Amount.ToString("C")</span>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Win Probability</label>
                        <span class="fs-4 fw-bold text-primary">@Model.Probability%</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Expected Close Date</label>
                    <span class="fw-medium">@Model.ExpectedCloseDate.ToString("MMMM dd, yyyy")</span>
                </div>

                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Associated Account</label>
                    @if (Model.Customer != null)
                    {
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-bold text-decoration-none">
                            <i class="bi bi-building me-1"></i> @Model.Customer.CustomerName
                        </a>
                    }
                    else if (Model.Lead != null)
                    {
                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId" class="fw-bold text-decoration-none">
                            <i class="bi bi-funnel me-1"></i> @Model.Lead.LeadName
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">Unlinked</span>
                    }
                </div>

                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Deal Owner</label>
                    <span class="badge bg-primary-subtle text-primary">@(Model.AssignedToUser != null ? Model.AssignedToUser.FullName : "Unassigned")</span>
                </div>

                <div>
                    <label class="text-muted small text-uppercase fw-semibold d-block">Source</label>
                    <span class="badge bg-light text-dark border">@Model.Source</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card mb-4">
                <div class="card-header bg-white">
                    <span class="fw-bold">Strategic Deal Notes</span>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-0 small" style="white-space: pre-wrap;">@Model.Notes</p>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header bg-white">
                <span class="fw-bold">Audit Meta</span>
            </div>
            <div class="card-body small text-muted">
                <div class="mb-2">Created at: @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
                @if (Model.ModifiedDate.HasValue)
                {
                    <div>Last updated: @Model.ModifiedDate.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
                }
            </div>
        </div>
    </div>
</div>
