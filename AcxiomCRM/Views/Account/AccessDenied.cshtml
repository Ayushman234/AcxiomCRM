@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="card auth-card border-0 text-center p-4">
    <div class="card-body py-5">
        <div class="stat-icon-wrapper stat-icon-danger mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
            <i class="bi bi-shield-x"></i>
        </div>
        <h3 class="fw-bold text-danger">403 - Access Denied</h3>
        <p class="text-muted mt-2 mb-4">
            You do not have the required role or authorization privileges to access this enterprise resource.
        </p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary px-4">
            <i class="bi bi-arrow-left me-2"></i>Return to Dashboard
        </a>
    </div>
</div>
