@model AcxiomCRM.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<div class="card auth-card border-0">
    <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="brand-logo-badge mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.5rem;">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <h3 class="fw-bold text-dark">Join AcxiomCRM</h3>
            <p class="text-muted small">Register your enterprise workspace account</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label fw-semibold small text-muted"></label>
                    <input asp-for="FirstName" class="form-control" placeholder="Jane" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label fw-semibold small text-muted"></label>
                    <input asp-for="LastName" class="form-control" placeholder="Doe" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control border-start-0" placeholder="jane.doe@company.com" autocomplete="username" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold small text-muted"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-key"></i></span>
                    <input asp-for="Password" class="form-control border-start-0" placeholder="Min 8 chars, 1 uppercase, 1 digit" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-muted"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-shield-check"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control border-start-0" placeholder="Repeat password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                <i class="bi bi-check2-circle me-2"></i>Create Account
            </button>
        </form>

        <div class="mt-4 pt-3 border-top text-center text-muted small">
            Already have an account? 
            <a asp-action="Login" class="text-primary text-decoration-none fw-semibold">Sign in</a>
        </div>
    </div>
</div>
