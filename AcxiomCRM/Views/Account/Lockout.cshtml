@{
    ViewData["Title"] = "Account Locked";
    Layout = "_Layout";
}

<div class="card auth-card border-0 text-center p-4">
    <div class="card-body py-5">
        <div class="stat-icon-wrapper stat-icon-warning mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
            <i class="bi bi-lock-fill"></i>
        </div>
        <h3 class="fw-bold text-warning">Account Locked Out</h3>
        <p class="text-muted mt-2 mb-4">
            Due to multiple failed sign-in attempts, your account has been temporarily locked out for security reasons. Please try again after 15 minutes or contact a system administrator.
        </p>
        <a asp-action="Login" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-2"></i>Back to Sign In
        </a>
    </div>
</div>
