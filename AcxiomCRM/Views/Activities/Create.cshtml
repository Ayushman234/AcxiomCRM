@model AcxiomCRM.ViewModels.ActivityVM
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
                    <h5 class="card-title mb-0 fw-bold">Log New Sales Interaction</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Subject" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Subject" class="form-control" placeholder="Introductory Discovery Call" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ActivityType" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="ActivityType" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.ActivityType>()"></select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ActivityDate" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DurationMinutes" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="DurationMinutes" class="form-control" type="number" placeholder="30" />
                            <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="Model.Customers">
                                <option value="">-- Customer (Optional) --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LeadId" class="form-label fw-semibold small text-muted"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="Model.Leads">
                                <option value="">-- Lead (Optional) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold small text-muted"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Summary of discussion, action items, customer feedback..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Log Activity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
