@model List<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "Activity Log";
    var filter = (AcxiomCRM.ViewModels.ActivityFilterVM)ViewBag.Filter;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Sales Activities</h2>
        <p class="text-muted mb-0 small">Audit interactions including phone calls, client meetings, emails, and notes</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
            <i class="bi bi-journal-plus me-2"></i> Log Activity
        </a>
    </div>
</div>

<!-- Filter Card -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="Search" value="@filter.Search" class="form-control" placeholder="Search subject or description..." />
            </div>
            <div class="col-md-5">
                <select name="Type" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.ActivityType>()">
                    <option value="">All Activity Types</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Activity Log</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Type</th>
                        <th>Subject / Summary</th>
                        <th>Associated With</th>
                        <th>Logged By</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var act in Model)
                        {
                            <tr>
                                <td class="small text-muted">@act.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <span class="badge @(act.ActivityType == ActivityType.Call ? "bg-info-subtle text-info" : act.ActivityType == ActivityType.Meeting ? "bg-primary-subtle text-primary" : act.ActivityType == ActivityType.Email ? "bg-warning-subtle text-warning" : "bg-secondary-subtle text-secondary")">
                                        @act.ActivityType
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold">@act.Subject</div>
                                    <div class="text-muted small">@act.Description</div>
                                </td>
                                <td>
                                    @if (act.Customer != null)
                                    {
                                        <div><i class="bi bi-building me-1 text-primary"></i>@act.Customer.CustomerName</div>
                                    }
                                    else if (act.Lead != null)
                                    {
                                        <div><i class="bi bi-funnel me-1 text-info"></i>@act.Lead.LeadName</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">General</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(act.AssignedToUser != null ? act.AssignedToUser.FullName : "System")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-text fs-1 d-block mb-2 text-muted"></i>
                                No activities logged yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @filter.Page of @totalPages</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(filter.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(filter.Page - 1)" asp-route-Search="@filter.Search">&laquo;</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(filter.Page == p ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-Page="@p" asp-route-Search="@filter.Search">@p</a>
                        </li>
                    }
                    <li class="page-item @(filter.Page >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(filter.Page + 1)" asp-route-Search="@filter.Search">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
