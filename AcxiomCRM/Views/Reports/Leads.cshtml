@model List<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Report";
    var filter = (AcxiomCRM.ViewModels.ReportFilterVM)ViewBag.Filter;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h2 class="fw-bold mb-0">Lead Acquisition Report</h2>
            <p class="text-muted small mb-0">Generated on @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC</p>
        </div>
    </div>
    <div>
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print / Save PDF
        </button>
    </div>
</div>

<div class="card mb-4 no-print">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="date" name="StartDate" value="@(filter.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" placeholder="From Date" />
            </div>
            <div class="col-md-4">
                <input type="date" name="EndDate" value="@(filter.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" placeholder="To Date" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Apply Date Filter</button>
                <a asp-action="Leads" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">Leads Dataset (@Model.Count items)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Lead Name</th>
                        <th>Email</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Priority</th>
                        <th>Expected Value</th>
                        <th>Status</th>
                        <th>Assignee</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var l in Model)
                        {
                            <tr>
                                <td class="fw-bold">@l.LeadName</td>
                                <td>@l.Email</td>
                                <td>@(string.IsNullOrEmpty(l.CompanyName) ? "-" : l.CompanyName)</td>
                                <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                                <td><span class="badge @(l.Priority == LeadPriority.High ? "bg-danger-subtle text-danger" : "bg-info-subtle text-info")">@l.Priority</span></td>
                                <td>@l.ExpectedValue.ToString("C0")</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@l.Status</span></td>
                                <td>@(l.AssignedToUser?.FullName ?? "Unassigned")</td>
                                <td class="small text-muted">@l.CreatedDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No leads found for the selected period.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
