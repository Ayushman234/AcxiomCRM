@model List<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Pipeline Report";
    var filter = (AcxiomCRM.ViewModels.ReportFilterVM)ViewBag.Filter;
    decimal totalVal = Model.Sum(x => x.Amount);
    decimal weightedVal = Model.Sum(x => x.Amount * x.Probability / 100m);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h2 class="fw-bold mb-0">Opportunity Pipeline Report</h2>
            <p class="text-muted small mb-0">Total: <strong>@totalVal.ToString("C0")</strong> | Weighted Pipeline: <strong>@weightedVal.ToString("C0")</strong></p>
        </div>
    </div>
    <div>
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print / Save PDF
        </button>
    </div>
</div>

<div class="card mb-4 no-print">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="date" name="StartDate" value="@(filter.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" placeholder="From Date" />
            </div>
            <div class="col-md-4">
                <input type="date" name="EndDate" value="@(filter.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" placeholder="To Date" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Apply Date Filter</button>
                <a asp-action="Opportunities" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">Opportunities Dataset (@Model.Count items)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Deal Name</th>
                        <th>Account / Prospect</th>
                        <th>Amount</th>
                        <th>Probability</th>
                        <th>Stage</th>
                        <th>Status</th>
                        <th>Expected Close</th>
                        <th>Deal Owner</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td class="fw-bold">@o.OpportunityName</td>
                                <td>@(o.Customer?.CustomerName ?? o.Lead?.LeadName ?? "-")</td>
                                <td class="fw-bold">@o.Amount.ToString("C0")</td>
                                <td>@o.Probability%</td>
                                <td><span class="badge bg-primary-subtle text-primary">@o.Stage</span></td>
                                <td><span class="badge bg-light text-dark border">@o.Status</span></td>
                                <td class="small text-muted">@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                <td>@(o.AssignedToUser?.FullName ?? "Unassigned")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No opportunities found for the selected period.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
