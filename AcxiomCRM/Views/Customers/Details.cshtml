@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = $"Customer - {Model.CustomerName}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h2 class="fw-bold mb-0">@Model.CustomerName</h2>
            <span class="badge bg-light text-dark border font-monospace me-2">@Model.CustomerCode</span>
            <span class="badge @(Model.Status == CustomerStatus.Active ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@Model.Status</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Customer
        </a>
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> New Opportunity
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Customer Profile Card -->
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header bg-white">
                <span class="fw-bold">Company Profile</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Company Name</label>
                    <span class="fw-medium">@(string.IsNullOrEmpty(Model.CompanyName) ? "N/A" : Model.CompanyName)</span>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Email Address</label>
                    <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Phone Number</label>
                    <span>@Model.Phone</span>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Location</label>
                    <span>@(string.Join(", ", new[] { Model.Address, Model.City, Model.State }.Where(s => !string.IsNullOrEmpty(s))))</span>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold d-block">Account Owner</label>
                    <span class="badge bg-primary-subtle text-primary">@(Model.AssignedToUser != null ? Model.AssignedToUser.FullName : "Unassigned")</span>
                </div>
                <div>
                    <label class="text-muted small text-uppercase fw-semibold d-block">Created On</label>
                    <span class="text-muted small">@Model.CreatedDate.ToString("MMM dd, yyyy HH:mm") UTC</span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card">
                <div class="card-header bg-white">
                    <span class="fw-bold">Enterprise Notes</span>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-0 small" style="white-space: pre-wrap;">@Model.Notes</p>
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Associated Deals and Activities -->
    <div class="col-lg-8">
        <!-- Opportunities Table -->
        <div class="card mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">Opportunities (@(Model.Opportunities?.Count ?? 0))</span>
                <a asp-controller="Opportunities" asp-action="Create" class="btn btn-sm btn-link text-decoration-none">Add Deal</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Amount</th>
                                <th>Stage</th>
                                <th>Expected Close</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Opportunities != null && Model.Opportunities.Any())
                            {
                                @foreach (var opp in Model.Opportunities)
                                {
                                    <tr>
                                        <td class="fw-semibold">@opp.OpportunityName</td>
                                        <td>@opp.Amount.ToString("C")</td>
                                        <td><span class="badge bg-info-subtle text-info">@opp.Stage</span></td>
                                        <td class="text-muted small">@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end">
                                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted small">No deals recorded for this account.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Follow-Ups Table -->
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">Scheduled Follow-Ups (@(Model.FollowUps?.Count ?? 0))</span>
                <a asp-controller="FollowUps" asp-action="Create" class="btn btn-sm btn-link text-decoration-none">Schedule Follow-up</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Scheduled Date</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.FollowUps != null && Model.FollowUps.Any())
                            {
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="small">@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">@f.FollowUpType</span></td>
                                        <td>
                                            <span class="badge @(f.Status == FollowUpStatus.Completed ? "bg-success-subtle text-success" : f.Status == FollowUpStatus.Planned ? "bg-warning-subtle text-warning" : "bg-danger-subtle text-danger")">
                                                @f.Status
                                            </span>
                                        </td>
                                        <td class="small text-muted">@f.Remarks</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted small">No scheduled follow-ups.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
