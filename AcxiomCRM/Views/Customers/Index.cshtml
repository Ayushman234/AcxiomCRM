@model List<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
    var filter = (AcxiomCRM.ViewModels.CustomerFilterVM)ViewBag.Filter;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Customers</h2>
        <p class="text-muted mb-0 small">Manage enterprise accounts, contacts, and communication profiles</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
            <i class="bi bi-person-plus-fill me-2"></i> Add Customer
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="Search" value="@filter.Search" class="form-control border-start-0" placeholder="Search name, email, company, code..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="Status" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.CustomerStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="SortBy" class="form-select">
                    <option value="name" selected="@(filter.SortBy == "name")">Sort by Name</option>
                    <option value="code" selected="@(filter.SortBy == "code")">Sort by Code</option>
                    <option value="created" selected="@(filter.SortBy == "created")">Sort by Created</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Customer List Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">All Accounts (@totalCount)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Customer / Company</th>
                        <th>Contact</th>
                        <th>Assigned To</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@c.CustomerCode</span>
                                </td>
                                <td>
                                    <div class="fw-bold">@c.CustomerName</div>
                                    <div class="text-muted small">@(string.IsNullOrEmpty(c.CompanyName) ? "Individual" : c.CompanyName)</div>
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope text-muted me-1 small"></i><a href="mailto:@c.Email" class="text-decoration-none text-dark">@c.Email</a></div>
                                    <div><i class="bi bi-telephone text-muted me-1 small"></i><span class="text-muted small">@c.Phone</span></div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        @(c.AssignedToUser != null ? c.AssignedToUser.FullName : "Unassigned")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(c.Status == CustomerStatus.Active ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                        @c.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-action-group">
                                        <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (User.IsInRole(AppRoles.Admin))
                                        {
                                            <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Delete customer @c.CustomerName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-building fs-1 d-block mb-2 text-muted"></i>
                                No customers found matching criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination Footer -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @filter.Page of @totalPages</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(filter.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(filter.Page - 1)" asp-route-Search="@filter.Search" asp-route-Status="@filter.Status" asp-route-SortBy="@filter.SortBy">&laquo;</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(filter.Page == p ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-Page="@p" asp-route-Search="@filter.Search" asp-route-Status="@filter.Status" asp-route-SortBy="@filter.SortBy">@p</a>
                        </li>
                    }
                    <li class="page-item @(filter.Page >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(filter.Page + 1)" asp-route-Search="@filter.Search" asp-route-Status="@filter.Status" asp-route-SortBy="@filter.SortBy">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
