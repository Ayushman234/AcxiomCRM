@model List<AcxiomCRM.ViewModels.UserListVM>
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">User Administration</h2>
        <p class="text-muted mb-0 small">Manage application access, role assignments, security lockouts, and status</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
            <i class="bi bi-person-plus-fill me-2"></i> Add New User
        </a>
    </div>
</div>

<!-- Search Card -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Search by name, email..." />
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">System Users (@Model.Count)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Security Lockout</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@u.FullName</div>
                                    <div class="text-muted small">@u.Email</div>
                                </td>
                                <td>
                                    <span class="badge @(u.Role == AppRoles.Admin ? "bg-dark" : u.Role == AppRoles.Manager ? "bg-primary" : "bg-info")">
                                        @u.Role
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(u.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                        @(u.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    @if (u.IsLockedOut)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Locked</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-unlock me-1"></i>Unlocked</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @u.CreatedDate.ToString("yyyy-MM-dd")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-action-group">
                                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-outline-warning" title="Reset Password">
                                            <i class="bi bi-key"></i>
                                        </a>
                                        @if (u.IsLockedOut)
                                        {
                                            <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Unlock this account?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success" title="Unlock Account">
                                                    <i class="bi bi-unlock-fill"></i>
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('@(u.IsActive ? "Deactivate" : "Activate") this user account?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">No users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
