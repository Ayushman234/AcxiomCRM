@model AcxiomCRM.ViewModels.ChangePasswordVM
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
                    <h5 class="card-title mb-0 fw-bold">Reset Password: @Model.UserName</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small mb-4">
                    As an administrator, specify a new password for this user. The user will be required to meet security complexity requirements (min 8 chars, 1 uppercase, 1 digit).
                </p>

                <form asp-action="ResetPassword" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="UserName" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="NewPassword" class="form-control" type="password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4"><i class="bi bi-key-fill me-1"></i> Reset Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
